rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'sohanur@kinzashop.local';
    }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.userUid == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.userUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /users/{id} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == id);
    }
  }
}
